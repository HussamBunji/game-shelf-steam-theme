    "Language": {
      "description": "Theme language / لغة الثيم",
      "default": "English",
      "tab": "General",
      "values": {
        "English": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "src/lang/en.css"
          }
        },
        "Arabic": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "src/lang/ar.css"
          }
        }
      }
    },
    "Family": {
      "description": "Family mode: hide games not suitable for the family from the store / وضع العائلة",
      "default": "On",
      "tab": "General",
      "values": {
        "On": {
          "TargetCss": {
            "affects": [
              ".*",
              "https://.*\\.steampowered\\.com(/.*)?",
              "https://steamcommunity\\.com(/.*)?"
            ],
            "src": "src/css/family-on.css"
          }
        },
        "Off": {
          "TargetCss": {
            "affects": [
              ".*",
              "https://.*\\.steampowered\\.com(/.*)?",
              "https://steamcommunity\\.com(/.*)?"
            ],
            "src": "src/css/family-off.css"
