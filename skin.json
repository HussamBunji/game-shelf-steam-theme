  },
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetJs": "src/js/skin.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "src/css/shelf.css",
      "TargetJs": "src/js/shelf.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "src/css/layouts.css"
    },
    {
      "MatchRegexString": "https://.*\\.steampowered\\.com(/.*)?",
      "TargetCss": "src/css/webkit.css",
      "TargetJs": "src/js/webkit.js"
    },
    {
      "MatchRegexString": "https://steamcommunity\\.com(/.*)?",
      "TargetCss": "src/css/webkit.css",
      "TargetJs": "src/js/webkit.js"
    },
    {
      "MatchRegexString": "^Steam Big Picture Mode$",
      "TargetCss": "src/css/bigpicture.css",
      "TargetJs": "src/js/bigpicture.js"
    }
  ]
}