{
  "name": "Game Shelf — رف الألعاب",
  "author": "Yousef (yousf612-alwazzan)",
  "description": "Twenty-four looks for Steam — Classic Shelf, Glass Gallery, Neon Coverflow, Terminal, RPG Vault, Vinyl Records, Corkboard, Retro Arcade, Magazine, Cupertino Dark, Cyberpunk, Shelter OS, Crossbar, Steam Original, plus SpaceTheme and Material You (MIT). Store stats panels, Ctrl+K search, full Arabic or English.",
  "version": "1.1.0",
  "header_image": "https://raw.githubusercontent.com/SteamClientHomebrew/Millennium/main/assets/header.png",
  "splash_image": "https://raw.githubusercontent.com/SteamClientHomebrew/Millennium/main/assets/header.png",
  "tags": [
    "Library",
    "3D",
    "Arabic",
    "Customizable"
  ],
  "github": {
    "owner": "yousf612-alwazzan",
    "repo_name": "game-shelf-steam-theme"
  },
  "Steam-WebKit": "src/css/webkit.css",
